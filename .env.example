# Supabase — required for production. Leave blank in dev to use DEV_BYPASS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
USER_PORTAL_URL=http://localhost:3000

# Stripe — required for billing actions on /admin/revenue
# When unset, billing routes return HTTP 503 with a clear "Stripe not wired" message.
STRIPE_SECRET_KEY=

# Phase E (uncomment when wiring)
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
