    "seed:ingest": "tsx supabase/seed/ingest-csvs.ts"
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "csv-parse": "^5.5.6",
    "eslint": "^8.57.0",
    "eslint-config-next": "^16.2.5",
    "postcss": "^8.4.47",
    "supabase": "^1.226.4",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
